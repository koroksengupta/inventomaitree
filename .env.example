# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored, so your values never get committed.
#
# Where to find them: Supabase dashboard -> Project Settings -> API (or "Data API")
#   - Project URL         -> VITE_SUPABASE_URL   (without /rest/v1/ at the end)
#   - Publishable / anon  -> VITE_SUPABASE_ANON_KEY
#
# NEVER put the service_role / secret key here. Anything starting with VITE_
# is bundled into the website and visible to anyone who opens it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
